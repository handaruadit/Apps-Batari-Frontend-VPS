EXPO_PUBLIC_API_ENV=vps
# Ganti dengan IP komputer yang menjalankan belajar-api saat memakai HP/Expo Go.
# Development with Expo Go: automatically use the Metro host IP.
EXPO_PUBLIC_API_USE_EXPO_HOST=true
EXPO_PUBLIC_API_PORT=3001

# Fallback/production override when automatic Expo host discovery is disabled.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3001
EXPO_PUBLIC_DEBUG_CHART=false
EXPO_PUBLIC_DEBUG_LAYOUT=false
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
